@model DeliveryTimePrediction.Models.DeliveryData

@{
    ViewData["Title"] = "Delivery Predictor";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;600;700&display=swap" rel="stylesheet">
<script src="https://unpkg.com/phosphor-icons"></script>

<style>
    :root {
        --primary: #6366f1;
        --primary-hover: #4f46e5;
        --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
        --card-bg: rgba(255, 255, 255, 0.85);
        --text-main: #1e293b;
        --text-muted: #64748b;
        --accent: #0ea5e9;
        --glass-border: rgba(255, 255, 255, 0.4);
        --shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
    }



    .app-container {
        width: 100%;
        max-width: 850px;
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .main-card {
        background: var(--card-bg);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid var(--glass-border);
        border-radius: 24px;
        padding: 40px;
        box-shadow: var(--shadow);
    }

    .header {
        text-align: center;
        margin-bottom: 40px;
    }

    .header i {
        font-size: 48px;
        color: var(--primary);
        margin-bottom: 15px;
        display: block;
    }

    .header h1 {
        font-weight: 700;
        font-size: 32px;
        margin: 0;
        background: linear-gradient(135deg, var(--primary), var(--accent));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        letter-spacing: -0.02em;
    }

    .header p {
        color: var(--text-muted);
        margin-top: 8px;
        font-size: 16px;
    }

    .grid-layout {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .grid-layout {
            grid-template-columns: 1fr;
        }
    }

    .form-section {
        background: rgba(255, 255, 255, 0.5);
        border: 1px solid rgba(0, 0, 0, 0.05);
        border-radius: 16px;
        padding: 20px;
        transition: transform 0.2s;
    }

    .form-section:hover {
        transform: translateY(-2px);
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 18px;
        color: var(--primary);
        font-weight: 600;
        font-size: 15px;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .input-group {
        margin-bottom: 15px;
    }

    .input-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-muted);
        margin-bottom: 6px;
    }

    input, select {
        width: 100%;
        padding: 12px 16px;
        border-radius: 10px;
        border: 1.5px solid #e2e8f0;
        background: white;
        font-family: inherit;
        font-size: 14px;
        transition: all 0.2s;
        box-sizing: border-box;
    }

    input:focus, select:focus {
        outline: none;
        border-color: var(--primary);
        box-shadow: 0 0 0 4px rgba(99, 102, 241, 0.1);
    }

    .btn-predict {
        grid-column: span 2;
        background: var(--primary);
        color: white;
        border: none;
        padding: 16px;
        border-radius: 12px;
        font-size: 16px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 20px;
        box-shadow: 0 10px 15px -3px rgba(99, 102, 241, 0.4);
    }

    @@media (max-width: 768px) {
        .btn-predict {
            grid-column: span 1;
        }
    }

    .btn-predict:hover {
        background: var(--primary-hover);
        transform: translateY(-2px);
        box-shadow: 0 20px 25px -5px rgba(99, 102, 241, 0.4);
    }

    .btn-predict:active {
        transform: translateY(0);
    }

    .result-container {
        margin-top: 40px;
        animation: slideUp 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    }

    @@keyframes slideUp {
        from { opacity: 0; transform: translateY(30px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .result-card {
        background: linear-gradient(135deg, var(--primary), var(--accent));
        padding: 30px;
        border-radius: 20px;
        color: white;
        text-align: center;
        position: relative;
        overflow: hidden;
        box-shadow: 0 20px 40px -10px rgba(99, 102, 241, 0.4);
    }

    .result-card::before {
        content: "";
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(circle, rgba(255,255,255,0.1) 0%, transparent 70%);
        pointer-events: none;
    }

    .result-label {
        font-size: 14px;
        font-weight: 500;
        opacity: 0.9;
        text-transform: uppercase;
        letter-spacing: 0.1em;
        margin-bottom: 8px;
    }

    .result-value {
        font-size: 48px;
        font-weight: 800;
        margin: 0;
        display: flex;
        align-items: baseline;
        justify-content: center;
        gap: 8px;
    }

    .result-unit {
        font-size: 18px;
        font-weight: 400;
        opacity: 0.8;
    }
</style>

<div class="app-container">
    <div class="main-card">
        <div class="header">
            <i class="ph-truck"></i>
            <h1>Delivery Estimator</h1>
            <p>Predict your shipment arrival time with AI precision</p>
        </div>

        <form id="predictionForm" asp-action="Index" method="post" class="grid-layout">
            <!-- Location & Route -->
            <div class="form-section">
                <div class="section-header">
                    <i class="ph-map-pin-line"></i>
                    <span>Route Details</span>
                </div>
                
                <div class="input-row">
                    <div class="input-group">
                        <label>Pickup Lat</label>
                        <input asp-for="PickupLat" type="number" step="any" placeholder="28.61" required />
                        <span asp-validation-for="PickupLat" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                    <div class="input-group">
                        <label>Pickup Long</label>
                        <input asp-for="PickupLong" type="number" step="any" placeholder="77.20" required />
                        <span asp-validation-for="PickupLong" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Drop Lat</label>
                        <input asp-for="DropLat" type="number" step="any" placeholder="28.70" required />
                        <span asp-validation-for="DropLat" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                    <div class="input-group">
                        <label>Drop Long</label>
                        <input asp-for="DropLong" type="number" step="any" placeholder="77.10" required />
                        <span asp-validation-for="DropLong" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                </div>

                <div class="input-group">
                    <label>Distance (km)</label>
                    <input asp-for="Distance" type="number" step="any" min="0" placeholder="5" required />
                    <span asp-validation-for="Distance" class="text-danger" style="font-size: 11px;"></span>
                </div>
            </div>

            <!-- External Factors -->
            <div class="form-section">
                <div class="section-header">
                    <i class="ph-cloud-rain"></i>
                    <span>External Conditions</span>
                </div>

                <div class="input-group">
                    <label>Traffic Intensity</label>
                    <select asp-for="TrafficLevel">
                        <option value="Low">Low</option>
                        <option value="Medium">Medium</option>
                        <option value="High">High</option>
                    </select>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Current Weather</label>
                        <select asp-for="Weather">
                            <option value="Clear">Clear</option>
                            <option value="Rain">Rain</option>
                            <option value="Storm">Storm</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label>Temp (°C)</label>
                        <input asp-for="Temperature" type="number" step="any" placeholder="25" />
                        <span asp-validation-for="Temperature" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Time Period</label>
                        <select asp-for="TimeOfDay">
                            <option>Morning</option>
                            <option>Afternoon</option>
                            <option>Evening</option>
                            <option>Night</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label>Weekday</label>
                        <select asp-for="DayOfWeek">
                            <option>Monday</option>
                            <option>Tuesday</option>
                            <option>Wednesday</option>
                            <option>Thursday</option>
                            <option>Friday</option>
                            <option>Saturday</option>
                            <option>Sunday</option>
                        </select>
                    </div>
                </div>
            </div>

            <!-- Vehicle & Type -->
            <div class="form-section">
                <div class="section-header">
                    <i class="ph-moped"></i>
                    <span>Service Config</span>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Vehicle Type</label>
                        <select asp-for="VehicleType">
                            <option>Bike</option>
                            <option>Car</option>
                            <option>Truck</option>
                        </select>
                    </div>
                    <div class="input-group">
                        <label>Priority</label>
                        <select asp-for="DeliveryType">
                            <option>Standard</option>
                            <option>Express</option>
                        </select>
                    </div>
                </div>

                <div class="input-row">
                    <div class="input-group">
                        <label>Total Stops</label>
                        <input asp-for="NumberOfStops" type="number" min="0" max="100" placeholder="2" />
                        <span asp-validation-for="NumberOfStops" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                    <div class="input-group">
                        <label>Avg Speed (km/h)</label>
                        <input asp-for="AverageSpeed" type="number" min="1" max="150" placeholder="40" />
                        <span asp-validation-for="AverageSpeed" class="text-danger" style="font-size: 11px;"></span>
                    </div>
                </div>
            </div>

            <!-- Driver Profile -->
            <div class="form-section">
                <div class="section-header">
                    <i class="ph-user-circle"></i>
                    <span>Courier Profile</span>
                </div>

                <div class="input-group">
                    <label>Experience Level (Years)</label>
                    <input asp-for="DriverExperience" type="number" min="0" max="50" placeholder="e.g. 3" />
                    <span asp-validation-for="DriverExperience" class="text-danger" style="font-size: 11px;"></span>
                </div>

                <div class="input-group">
                    <label>Rating (1-5)</label>
                    <input asp-for="DriverRating" type="number" step="0.1" max="5" min="1" placeholder="4.5" required />
                    <span asp-validation-for="DriverRating" class="text-danger" style="font-size: 11px;"></span>
                </div>
            </div>

            <button type="submit" class="btn-predict">
                <i class="ph-sparkle"></i>
                Calculate ETA
            </button>
        </form>

        @if (ViewBag.Result != null && ViewData.ModelState.IsValid)
        {
            <div class="result-container" id="resultSection">
                <div class="result-card">
                    <div class="result-label">Estimated Delivery In</div>
                    <div class="result-value">
                        @Math.Round((double)ViewBag.Result, 1)
                        <span class="result-unit">minutes</span>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById("predictionForm").addEventListener("submit", function (e) {
            e.preventDefault();

            // Client-side validation check
            if (!$(this).valid()) {
                return;
            }

            const form = this;
            const formData = new FormData(form);

            fetch(form.action, {
                method: "POST",
                body: formData
            })
            .then(response => response.text())
            .then(html => {
                const parser = new DOMParser();
                const doc = parser.parseFromString(html, "text/html");

                const newResult = doc.querySelector("#resultSection");
                const currentResult = document.getElementById("resultSection");

                if (newResult) {
                    if (!currentResult) {
                        form.insertAdjacentHTML("afterend", newResult.outerHTML);
                    } else {
                        currentResult.outerHTML = newResult.outerHTML;
                    }
                    
                    document.getElementById("resultSection").scrollIntoView({
                        behavior: "smooth"
                    });
                } else {
                    if (currentResult) {
                        currentResult.remove();
                    }
                    
                    const newForm = doc.querySelector("#predictionForm");
                    if (newForm) {
                        form.innerHTML = newForm.innerHTML;
                    }
                }
            })
            .catch(err => console.error(err));
        });
    </script>
}
>