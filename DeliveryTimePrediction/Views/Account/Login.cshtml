@model DeliveryTimePrediction.Models.LoginModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - Delivery Estimator</title>
    <link rel="stylesheet" href="~/css/auth.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
    <div class="grid-bg"></div>
    <div class="bg-blob blob-1"></div>

    <div id="flower-overlay">
        <h2 style="color: #60a5fa; font-family: 'Courier New', Courier, monospace; letter-spacing: 2px;">OPENING DASHBOARD... 🚀</h2>
    </div>

    <div class="auth-container">
        <div class="auth-header">
            <h1>System Login</h1>
            <p>Access the delivery prediction engine</p>
        </div>

        @if (ViewBag.Error != null)
        {
            <div class="error-message">
                @ViewBag.Error
            </div>
        }

        <form asp-action="Login" method="post">
            <div class="form-group">
                <label asp-for="Email">Email Address</label>
                <div class="input-wrapper">
                    <input asp-for="Email" type="email" placeholder="Enter your email" autocomplete="email" required />
                </div>
                <span asp-validation-for="Email" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <div class="input-wrapper">
                    <input asp-for="Password" type="password" placeholder="••••••••" required />
                </div>
                <span asp-validation-for="Password" class="validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">SECURE LOGIN</button>
        </form>

        <div class="auth-footer">
            <p>New here? <a asp-action="Register">Create account</a></p>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>

    <script>
        document.querySelector('form').addEventListener('submit', function(e) {
            e.preventDefault();
            const form = this;
            const overlay = document.getElementById('flower-overlay');
            overlay.style.display = 'flex';

            // Create digital data bits animation
            for (let i = 0; i < 50; i++) {
                const bit = document.createElement('div');
                bit.className = 'data-bit';
                bit.innerHTML = Math.random() > 0.5 ? '1' : '0';
                bit.style.left = Math.random() * 100 + 'vw';
                bit.style.top = Math.random() * 100 + 'vh';
                bit.style.animationDelay = Math.random() * 1 + 's';
                overlay.appendChild(bit);
            }

            setTimeout(() => {
                form.submit();
            }, 1500);
        });
    </script>
</body>
</html>